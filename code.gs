function doGet(e) { return ContentService.createTextOutput( "Movie Event Registration Web App is working!" ); } function doPost(e) { try { let data = JSON.parse(e.postData.contents); let name = data.name; let email = data.email; let movie = data.movie; let date = data.date; let tickets = data.tickets; let document = DocumentApp.create( "Movie Registration - " + name ); let body = document.getBody(); body.appendParagraph("MOVIE EVENT REGISTRATION") .setHeading(DocumentApp.ParagraphHeading.HEADING1); body.appendParagraph("Registration Details") .setHeading(DocumentApp.ParagraphHeading.HEADING2); body.appendParagraph("Name: " + name); body.appendParagraph("Email: " + email); body.appendParagraph("Movie: " + movie); body.appendParagraph("Event Date: " + date); body.appendParagraph("Number of Tickets: " + tickets); body.appendParagraph(""); body.appendParagraph("Thank you for registering!"); document.saveAndClose(); let file = DriveApp.getFileById(document.getId()); let pdf = file.getAs(MimeType.PDF); MailApp.sendEmail({ to: email, subject: "Movie Event Registration Receipt", body: "Hello " + name + ",\n\n" + "Thank you for registering for our movie event.\n\n" + "Movie: " + movie + "\n" + "Date: " + date + "\n" + "Tickets: " + tickets + "\n\n" + "Your registration receipt is attached as a PDF.\n\n" + "Thank you!", attachments: [pdf] }); return ContentService.createTextOutput( "Registration successful!" ); } catch (error) { return ContentService.createTextOutput( "Error: " + error.message ); } }
